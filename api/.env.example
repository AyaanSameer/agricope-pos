# Copy to .env for local development. Production reads these from the
# platform's secret manager — never from a file in the repo.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://localhost:5432/agricope_pos
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-48-random-bytes-before-anything-real
# Keyed into every PIN hash. Changing it invalidates every PIN.
PIN_PEPPER=change-me-too-and-never-share-it
# Order numbers and "today" follow the business's clock
BUSINESS_TZ=Asia/Qatar
# Serve the built frontend from this process (production). Leave unset in dev — Vite proxies.
# STATIC_DIR=../app/dist
LOG_LEVEL=info
